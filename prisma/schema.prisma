generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model bookmarks {
  id         String   @id @db.VarChar(36)
  user_id    String?  @db.VarChar(36)
  novel_id   String?  @db.VarChar(36)
  comic_id   String?  @db.VarChar(36)
  created_at DateTime @default(now()) @db.Timestamp(0)
  users      users?   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "bookmarks_ibfk_1")
  novels     novels?  @relation(fields: [novel_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "bookmarks_ibfk_2")
  comics     comics?  @relation(fields: [comic_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "bookmarks_ibfk_3")

  @@index([comic_id], map: "comic_id")
  @@index([novel_id], map: "novel_id")
  @@index([user_id], map: "user_id")
}

model categories {
  id     String   @id @db.VarChar(36)
  name   String?  @unique(map: "name") @db.VarChar(255)
  slug   String?  @unique(map: "slug") @db.VarChar(255)
  comics comics[]
  novels novels[]
  novel_categories novel_categories[]
  comic_categories comic_categories[]
}

model chapters {
  id            String   @id @db.VarChar(36)
  title         String   @db.VarChar(255)
  content       String?  @db.LongText
  chapter_order Int?
  novel_id      String?  @db.VarChar(36)
  views         Int?     @default(0)
  price         Int      @default(0)
  created_at    DateTime @default(now()) @db.Timestamp(0)
  updated_at    DateTime @default(now()) @db.Timestamp(0)
  purchases     purchases[]
  reading_history reading_history[]
  item_reads    item_reads[]
  novels        novels?  @relation(fields: [novel_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "chapters_ibfk_1")

  @@index([novel_id], map: "novel_id")
}

model comic_episodes {
  id            String        @id @db.VarChar(36)
  title         String        @db.VarChar(255)
  episode_order Int?
  comic_id      String?       @db.VarChar(36)
  views         Int?          @default(0)
  price         Int           @default(0)
  created_at    DateTime      @default(now()) @db.Timestamp(0)
  updated_at    DateTime      @default(now()) @db.Timestamp(0)
  comics        comics?       @relation(fields: [comic_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "comic_episodes_ibfk_1")
  comic_pages   comic_pages[]
  purchases     purchases[]
  reading_history reading_history[]
  item_reads    item_reads[]

  @@index([comic_id], map: "comic_id")
}

model comic_pages {
  id             String          @id @db.VarChar(36)
  image_url      String          @db.VarChar(255)
  page_order     Int?
  episode_id     String?         @db.VarChar(36)
  comic_episodes comic_episodes? @relation(fields: [episode_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "comic_pages_ibfk_1")

  @@index([episode_id], map: "episode_id")
}

model comics {
  id             String           @id @db.VarChar(36)
  title          String           @db.VarChar(255)
  description    String?          @db.Text
  cover_image    String?          @db.VarChar(255)
  status         comics_status?   @default(DRAFT)
  author_id      String?          @db.VarChar(36)
  category_id    String?          @db.VarChar(36)
  views          Int?             @default(0)
  created_at     DateTime         @default(now()) @db.Timestamp(0)
  updated_at     DateTime         @default(now()) @db.Timestamp(0)
  bookmarks      bookmarks[]
  comic_episodes comic_episodes[]
  comments       comments[]
  ratings        ratings[]
  reading_history reading_history[]
  comic_categories comic_categories[]
  users          users?           @relation(fields: [author_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "comics_ibfk_1")
  categories     categories?      @relation(fields: [category_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "comics_ibfk_2")

  @@index([author_id], map: "author_id")
  @@index([category_id], map: "category_id")
}

model login_attempts {
  id         BigInt   @id @default(autoincrement())
  email      String   @db.VarChar(255)
  ip         String   @db.VarChar(64)
  created_at DateTime @default(now()) @db.Timestamp(0)

  @@index([email, created_at], map: "idx_email_time")
  @@index([ip, created_at], map: "idx_ip_time")
  @@index([created_at], map: "idx_time")
}

model register_attempts {
  id         BigInt   @id @default(autoincrement())
  ip         String   @db.VarChar(64)
  created_at DateTime @default(now()) @db.Timestamp(0)

  @@index([ip, created_at], map: "idx_ip_time")
  @@index([created_at], map: "idx_time")
}

model novels {
  id          String         @id @db.VarChar(36)
  title       String         @db.VarChar(255)
  description String?        @db.Text
  cover_image String?        @db.VarChar(255)
  status      novels_status? @default(DRAFT)
  author_id   String?        @db.VarChar(36)
  category_id String?        @db.VarChar(36)
  views       Int?           @default(0)
  created_at  DateTime       @default(now()) @db.Timestamp(0)
  updated_at  DateTime       @default(now()) @db.Timestamp(0)
  bookmarks   bookmarks[]
  chapters    chapters[]
  comments    comments[]
  ratings     ratings[]
  reading_history reading_history[]
  novel_categories novel_categories[]
  users       users?         @relation(fields: [author_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "novels_ibfk_1")
  categories  categories?    @relation(fields: [category_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "novels_ibfk_2")

  @@index([author_id], map: "author_id")
  @@index([category_id], map: "category_id")
}

model reports {
  id          String              @id @db.VarChar(36)
  reporter_id String?             @db.VarChar(36)
  target_id   String?             @db.VarChar(36)
  target_type reports_target_type
  reason      String?             @db.Text
  status      reports_status?     @default(PENDING)
  created_at  DateTime            @default(now()) @db.Timestamp(0)
  users       users?              @relation(fields: [reporter_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "reports_ibfk_1")

  @@index([reporter_id], map: "reporter_id")
}

model system_settings {
  id               String   @id @db.VarChar(36)
  site_name        String?  @default("LoveRead") @db.VarChar(255)
  site_description String?  @db.Text
  contact_email    String?  @db.VarChar(255)
  maintenance_mode Boolean? @default(false)
  author_share_percent Int  @default(70)
  payment_info     String?  @db.Text
  updated_at       DateTime @default(now()) @db.Timestamp(0)
}

model users {
  id              String            @id @db.VarChar(36)
  name            String?           @db.VarChar(255)
  email           String?           @unique(map: "email") @db.VarChar(255)
  password        String?           @db.VarChar(255)
  image           String?           @db.VarChar(255)
  role            users_role?       @default(READER)
  coins           Int               @default(0)
  created_at      DateTime          @default(now()) @db.Timestamp(0)
  updated_at      DateTime          @default(now()) @db.Timestamp(0)
  bookmarks       bookmarks[]
  coin_topups     coin_topups[]
  comments        comments[]
  ratings         ratings[]
  reading_history reading_history[]
  item_reads      item_reads[]
  notifications   notifications[] @relation("notification_recipient")
  notifications_caused notifications[] @relation("notification_actor")
  comics          comics[]
  novels          novels[]
  purchases       purchases[]       @relation("purchases_buyer")
  sales           purchases[]       @relation("purchases_author")
  reports         reports[]
  withdrawals     withdrawals[]
  writer_profiles writer_profiles?
}

model withdrawals {
  id                  String              @id @db.VarChar(36)
  user_id             String?             @db.VarChar(36)
  amount              Decimal             @db.Decimal(10, 2)
  bank_name           String?             @db.VarChar(100)
  bank_account_number String?             @db.VarChar(50)
  bank_account_name   String?             @db.VarChar(255)
  status              withdrawals_status? @default(PENDING)
  slip_image          String?             @db.VarChar(255)
  rejection_reason    String?             @db.Text
  created_at          DateTime            @default(now()) @db.Timestamp(0)
  updated_at          DateTime            @default(now()) @db.Timestamp(0)
  users               users?              @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "withdrawals_ibfk_1")

  @@index([user_id], map: "user_id")
}

model writer_profiles {
  user_id             String                  @id @db.VarChar(36)
  title               String?                 @db.VarChar(50)
  first_name          String?                 @db.VarChar(255)
  last_name           String?                 @db.VarChar(255)
  id_card_number      String?                 @db.VarChar(20)
  address             String?                 @db.Text
  province            String?                 @db.VarChar(100)
  district            String?                 @db.VarChar(100)
  sub_district        String?                 @db.VarChar(100)
  postal_code         String?                 @db.VarChar(20)
  phone_number        String?                 @db.VarChar(20)
  bank_name           String?                 @db.VarChar(100)
  bank_account_name   String?                 @db.VarChar(255)
  bank_account_number String?                 @db.VarChar(50)
  id_card_image       String?                 @db.VarChar(255)
  bank_book_image     String?                 @db.VarChar(255)
  status              writer_profiles_status? @default(PENDING)
  rejection_reason    String?                 @db.Text
  created_at          DateTime                @default(now()) @db.Timestamp(0)
  updated_at          DateTime                @default(now()) @db.Timestamp(0)
  users               users                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "writer_profiles_ibfk_1")
}

model coin_topups {
  id               String              @id @db.VarChar(36)
  user_id          String              @db.VarChar(36)
  amount           Int
  slip_image       String              @db.VarChar(255)
  status           coin_topups_status? @default(PENDING)
  rejection_reason String?             @db.Text
  created_at       DateTime            @default(now()) @db.Timestamp(0)
  updated_at       DateTime            @default(now()) @db.Timestamp(0)
  users            users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "coin_topups_ibfk_1")

  @@index([user_id], map: "user_id")
}

model purchases {
  id             String          @id @db.VarChar(36)
  user_id        String          @db.VarChar(36)
  chapter_id     String?         @db.VarChar(36)
  episode_id     String?         @db.VarChar(36)
  item_title     String?         @db.VarChar(255)
  author_id      String          @db.VarChar(36)
  price          Int
  author_earning Decimal         @db.Decimal(10, 2)
  created_at     DateTime        @default(now()) @db.Timestamp(0)
  buyer          users           @relation("purchases_buyer", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "purchases_ibfk_1")
  chapters       chapters?       @relation(fields: [chapter_id], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "purchases_ibfk_2")
  comic_episodes comic_episodes? @relation(fields: [episode_id], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "purchases_ibfk_3")
  author         users           @relation("purchases_author", fields: [author_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "purchases_ibfk_4")

  @@unique([user_id, chapter_id], map: "uniq_user_chapter")
  @@unique([user_id, episode_id], map: "uniq_user_episode")
  @@index([author_id], map: "idx_author")
  @@index([chapter_id], map: "chapter_id")
  @@index([episode_id], map: "episode_id")
}

model comments {
  id         String     @id @db.VarChar(36)
  user_id    String     @db.VarChar(36)
  novel_id   String?    @db.VarChar(36)
  comic_id   String?    @db.VarChar(36)
  parent_id  String?    @db.VarChar(36)
  body       String     @db.Text
  created_at DateTime   @default(now()) @db.Timestamp(3)
  users      users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "comments_ibfk_1")
  novels     novels?    @relation(fields: [novel_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "comments_ibfk_2")
  comics     comics?    @relation(fields: [comic_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "comments_ibfk_3")
  parent     comments?  @relation("comment_replies", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "comments_ibfk_4")
  replies    comments[] @relation("comment_replies")

  @@index([novel_id, created_at], map: "idx_novel_time")
  @@index([comic_id, created_at], map: "idx_comic_time")
  @@index([user_id, created_at], map: "idx_user_time")
  @@index([parent_id, created_at], map: "idx_parent_time")
}

model notifications {
  id         String   @id @db.VarChar(36)
  user_id    String   @db.VarChar(36)
  actor_id   String?  @db.VarChar(36)
  type       String   @db.VarChar(32)
  message    String   @db.VarChar(500)
  link       String   @db.VarChar(500)
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(3)
  users      users    @relation("notification_recipient", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "notifications_ibfk_1")
  actor      users?   @relation("notification_actor", fields: [actor_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "notifications_ibfk_2")

  @@index([user_id, created_at], map: "idx_user_time")
  @@index([user_id, is_read], map: "idx_user_unread")
}

model reading_history {
  id             String          @id @db.VarChar(36)
  user_id        String          @db.VarChar(36)
  novel_id       String?         @db.VarChar(36)
  comic_id       String?         @db.VarChar(36)
  chapter_id     String?         @db.VarChar(36)
  episode_id     String?         @db.VarChar(36)
  read_at        DateTime        @default(now()) @db.Timestamp(3)
  users          users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "reading_history_ibfk_1")
  novels         novels?         @relation(fields: [novel_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "reading_history_ibfk_2")
  comics         comics?         @relation(fields: [comic_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "reading_history_ibfk_3")
  chapters       chapters?       @relation(fields: [chapter_id], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "reading_history_ibfk_4")
  comic_episodes comic_episodes? @relation(fields: [episode_id], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "reading_history_ibfk_5")

  @@unique([user_id, novel_id], map: "uniq_user_novel")
  @@unique([user_id, comic_id], map: "uniq_user_comic")
  @@index([user_id, read_at], map: "idx_user_time")
  @@index([novel_id], map: "novel_id")
  @@index([comic_id], map: "comic_id")
  @@index([chapter_id], map: "chapter_id")
  @@index([episode_id], map: "episode_id")
}

model item_reads {
  id             String          @id @db.VarChar(36)
  user_id        String          @db.VarChar(36)
  chapter_id     String?         @db.VarChar(36)
  episode_id     String?         @db.VarChar(36)
  read_at        DateTime        @default(now()) @db.Timestamp(3)
  users          users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "item_reads_ibfk_1")
  chapters       chapters?       @relation(fields: [chapter_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "item_reads_ibfk_2")
  comic_episodes comic_episodes? @relation(fields: [episode_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "item_reads_ibfk_3")

  @@unique([user_id, chapter_id], map: "uniq_user_chapter")
  @@unique([user_id, episode_id], map: "uniq_user_episode")
  @@index([chapter_id], map: "chapter_id")
  @@index([episode_id], map: "episode_id")
}

model ratings {
  id         String   @id @db.VarChar(36)
  user_id    String   @db.VarChar(36)
  novel_id   String?  @db.VarChar(36)
  comic_id   String?  @db.VarChar(36)
  score      Int      @db.TinyInt
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "ratings_ibfk_1")
  novels     novels?  @relation(fields: [novel_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "ratings_ibfk_2")
  comics     comics?  @relation(fields: [comic_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "ratings_ibfk_3")

  @@unique([user_id, novel_id], map: "uniq_user_novel")
  @@unique([user_id, comic_id], map: "uniq_user_comic")
  @@index([novel_id], map: "idx_novel")
  @@index([comic_id], map: "idx_comic")
}

enum coin_topups_status {
  PENDING
  APPROVED
  REJECTED
}

enum reports_target_type {
  NOVEL
  COMIC
  USER
  COMMENT
}

enum comics_status {
  DRAFT
  PUBLISHED
  ARCHIVED
  BANNED
}

enum novels_status {
  DRAFT
  PUBLISHED
  ARCHIVED
  BANNED
}

enum reports_status {
  PENDING
  RESOLVED
  IGNORED
}

enum users_role {
  VISITOR
  READER
  AUTHOR
  ADMIN
  BANNED
}

enum withdrawals_status {
  PENDING
  APPROVED
  REJECTED
}

enum writer_profiles_status {
  PENDING
  APPROVED
  REJECTED
}

/// Categories of each novel (up to 5, in the order picked). novels.category_id mirrors the first one.
model novel_categories {
  novel_id    String     @db.VarChar(36)
  category_id String     @db.VarChar(36)
  sort_order  Int        @default(0) @db.TinyInt
  novels      novels     @relation(fields: [novel_id], references: [id], onDelete: Cascade)
  categories  categories @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@id([novel_id, category_id])
  @@index([category_id], map: "idx_category")
}

/// Categories of each comic (up to 5, in the order picked). comics.category_id mirrors the first one.
model comic_categories {
  comic_id    String     @db.VarChar(36)
  category_id String     @db.VarChar(36)
  sort_order  Int        @default(0) @db.TinyInt
  comics      comics     @relation(fields: [comic_id], references: [id], onDelete: Cascade)
  categories  categories @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@id([comic_id, category_id])
  @@index([category_id], map: "idx_category")
}
