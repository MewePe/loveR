// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  VISITOR
  READER
  AUTHOR
  ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  BANNED
}

enum ContentType {
  NOVEL
  COMIC
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(READER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  novels        Novel[]
  comics        Comic[]
  comments      Comment[]
  bookmarks     Bookmark[]
  reports       Report[]
  
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  
  novels Novel[]
  comics Comic[]
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  
  novels Novel[]
  comics Comic[]
}

model Novel {
  id          String        @id @default(cuid())
  title       String
  description String        @db.Text
  coverImage  String?
  status      ContentStatus @default(DRAFT)
  authorId    String
  categoryId  String?
  views       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  author      User          @relation(fields: [authorId], references: [id])
  category    Category?     @relation(fields: [categoryId], references: [id])
  chapters    Chapter[]
  tags        Tag[]
  bookmarks   Bookmark[]
  comments    Comment[]
  reports     Report[]
}

model Chapter {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.LongText // HTML or Markdown content
  order     Int
  novelId   String
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
}

model Comic {
  id          String        @id @default(cuid())
  title       String
  description String        @db.Text
  coverImage  String?
  status      ContentStatus @default(DRAFT)
  authorId    String
  categoryId  String?
  views       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  author      User          @relation(fields: [authorId], references: [id])
  category    Category?     @relation(fields: [categoryId], references: [id])
  episodes    ComicEpisode[]
  tags        Tag[]
  bookmarks   Bookmark[]
  comments    Comment[]
  reports     Report[]
}

model ComicEpisode {
  id        String   @id @default(cuid())
  title     String
  order     Int
  comicId   String
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comic     Comic       @relation(fields: [comicId], references: [id], onDelete: Cascade)
  pages     ComicPage[]
}

model ComicPage {
  id        String @id @default(cuid())
  imageUrl  String
  order     Int
  episodeId String

  episode   ComicEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

model Bookmark {
  id        String      @id @default(cuid())
  userId    String
  novelId   String?
  comicId   String?
  createdAt DateTime    @default(now())

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel     Novel?      @relation(fields: [novelId], references: [id])
  comic     Comic?      @relation(fields: [comicId], references: [id])

  @@unique([userId, novelId])
  @@unique([userId, comicId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  userId    String
  novelId   String?
  comicId   String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel     Novel?   @relation(fields: [novelId], references: [id])
  comic     Comic?   @relation(fields: [comicId], references: [id])
}

model Report {
  id        String   @id @default(cuid())
  reason    String
  userId    String
  novelId   String?
  comicId   String?
  status    String   @default("PENDING") // PENDING, RESOLVED, REJECTED
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  novel     Novel?   @relation(fields: [novelId], references: [id])
  comic     Comic?   @relation(fields: [comicId], references: [id])
}
